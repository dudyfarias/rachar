{
  "expo": {
    "name": "Rachaê",
    "slug": "rachae",
    "version": "0.3.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "rachae",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rachae.app"
    },
    "android": {
      "package": "com.rachae.app",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Permita que o Rachae use a camera para capturar comandas.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permita que o Rachae leia imagens de comandas da galeria."
        }
      ]
    ],
    "web": {
      "bundler": "metro"
    }
  }
}
